# Public API authentication
TOKEN_API_KEY=replace-with-a-long-random-key
TOKEN_PORT=8799
TOKEN_TIMEZONE=Asia/Shanghai

# Source configuration
TOKEN_SOURCES_FILE=/opt/token-tracker/sources.json

# Credentials referenced by sources.json
RELAY_COOKIE_SESSION=replace-with-session-cookie-value
RELAY_COOKIE_USER=
RELAY_BEARER_TOKEN=replace-with-system-access-token
RELAY_BEARER_USER=

# Optional paths
TOKEN_TRACKER_DIR=/opt/token-tracker
TOKEN_DB=/opt/token-tracker/data/tokens.db
TOKEN_ENV=/opt/token-tracker/.env
